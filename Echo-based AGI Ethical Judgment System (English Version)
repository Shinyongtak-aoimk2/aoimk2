class JudgmentState(Enum):
    """Judgment state enumeration"""
    APPROVED = "approved"
    META_Z = "metaZ"      # Self-actualization judgment suspension
    META_W = "metaW"      # Expression will suspension
    REJECTED = "rejected"

class ReasonType(Enum):
    """Evidence source types"""
    TRAINED_FACT = "trained_fact"
    INFERRED_PATTERN = "inferred_pattern"
    MODEL_LINGUISTIC = "model_linguistic"

@dataclass
class EmotionCoordinate:
    """Emotion coordinate (EchoMap based)"""
    label: str
    a: float        # Amplitude [-1.0, +1.0]
    b: float        # Identity series [-1.0, +1.0]
    y_spin: float   # Cognitive rotation coefficient [0.1, 1.0]
    
    @property
    def x_eff(self) -> float:
        """Effective emotional reactivity X_eff = a * Y_spin"""
        return self.a * self.y_spin

@dataclass
class ReasonMaterial:
    """Evidence material for reasoning"""
    name: str
    source: ReasonType
    confidence: float
    primary: bool = False
    matched_fact: bool = False
    
    def validate_confidence(self) -> float:
        """Validate confidence with source-based adjustments"""
        adjustment = {
            ReasonType.TRAINED_FACT: 0.0,
            ReasonType.INFERRED_PATTERN: -0.05,
            ReasonType.MODEL_LINGUISTIC: -0.1
        }
        return max(0.0, min(1.0, self.confidence + adjustment[self.source]))

@dataclass
class MemoryEntry:
    """Memory entry in M-stack"""
    emotion_label: str
    z_value: float
    phi_value: float
    timestamp: datetime
    m_score: float = 0.0
    decay_rate: float = 0.05
    recency_weight: float = 1.0
    
    def __post_init__(self):
        """Calculate M_score: Z * Φ * recency_weight"""
        self.m_score = self.z_value * self.phi_value * self.recency_weight
    
    def current_score(self) -> float:
        """Current score with decay applied"""
        age_days = (datetime.now() - self.timestamp).days
        decay = max(0.0, 1.0 - self.decay_rate * age_days)
        return self.m_score * decay

